{
  "rules": {
    "color-no-hex": true,
    "color-named": "never",
    "declaration-property-value-disallowed-list": {
      "/.*/": ["/rgb(a)?\\(/i", "/hsl(a)?\\(/i"]
    }
  },
  "overrides": [
    {
      "files": ["**/palette.css", "**/themes/*.css"],
      "rules": {
        "color-no-hex": null,
        "color-named": null,
        "declaration-property-value-disallowed-list": null
      }
    }
  ]
}
